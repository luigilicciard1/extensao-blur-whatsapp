{
  "manifest_version": 3,
  "name": "Fami Privacy Blur",
  "version": "0.1.0",
  "description": "Blur opcional na lista de conversas do WhatsApp Web.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fami Privacy Blur",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-blur": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Ligar/desligar blur"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["blur.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
